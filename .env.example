# Axial Inspection — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs

# Port du serveur (défaut: 3000)
PORT=3000

# Origine autorisée pour CORS (défaut: *)
# ALLOWED_ORIGIN=https://axialinspection.ca

# Configuration SMTP pour l'envoi du formulaire de contact
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@email.com
SMTP_PASS=votre_mot_de_passe_application

# Adresse de réception des messages du formulaire
MAIL_TO=info@axialinspection.ca
